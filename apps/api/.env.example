# Copy to apps/api/.env and fill in. `.env` is git-ignored; this file is the documented shape.
# Every variable is validated at boot by apps/api/src/config/env.ts — a bad value stops the process.
# The desktop app sets all of these itself; this file is for `pnpm start:api` during development.

NODE_ENV=development
PORT=3333

# SQLite file with the saved connections, run history and log. A relative path resolves against the
# working directory — the repo root for every pnpm/nx command.
DATABASE_URL=file:./.data/mirrorbase.db

CORS_ORIGINS=http://localhost:4200

# Encrypts saved passwords with AES-256-GCM. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The desktop app creates and protects its own key (OS keychain) - this is for development only.
SETTINGS_ENCRYPTION_KEY=

# Where dump files are staged while a run is in progress. Empty = the OS temp directory.
WORK_DIR=
