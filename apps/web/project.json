{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "dr-note-no-test-target": "Deliberate \u2014 see the Testing section in CLAUDE.md. Vitest fails inside Nx's run-commands spawn, so tests run via `pnpm test` or `pnpm vitest run --project web`.",
  "dr-note-desktop-build": "build:desktop = the build the desktop app serves via app:// (apps/desktop), into dist/apps/web-desktop. Production, but without critical-CSS inlining: its `onload` handler would need inline script under the desktop's strict CSP.",
  "prefix": "dr",
  "sourceRoot": "apps/web/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          }
        ],
        "styles": [
          "node_modules/@fontsource-variable/inter/index.css",
          "apps/web/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.3mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "desktop": {
          "outputPath": "dist/apps/web-desktop",
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/web/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dr-note": "The Angular build type-checks the app; this covers the specs too (Vitest's transform does not type-check).",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc -p apps/web/tsconfig.spec.json --noEmit",
        "cwd": "."
      }
    }
  },
  "dr-note-bundle-budget": "The initial bundle is ~1.1 MB raw (Angular, zod, locale data, spartan). It is loaded from disk by the desktop app, so raw size is not a transfer cost; the budget only catches an accidental doubling."
}
