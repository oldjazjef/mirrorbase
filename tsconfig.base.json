{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@mirrorbase/db-plugin": ["./libs/db-plugin/src/index.ts"],
      "@mirrorbase/plugin-postgres": ["./libs/plugin-postgres/src/index.ts"],
      "@mirrorbase/plugin-sqlite": ["./libs/plugin-sqlite/src/index.ts"],
      "@mirrorbase/ui/badge": ["./libs/ui/badge/src/index.ts"],
      "@mirrorbase/ui/button": ["./libs/ui/button/src/index.ts"],
      "@mirrorbase/ui/card": ["./libs/ui/card/src/index.ts"],
      "@mirrorbase/ui/dialog": ["./libs/ui/dialog/src/index.ts"],
      "@mirrorbase/ui/dropdown-menu": ["./libs/ui/dropdown-menu/src/index.ts"],
      "@mirrorbase/ui/input": ["./libs/ui/input/src/index.ts"],
      "@mirrorbase/ui/input-group": ["./libs/ui/input-group/src/index.ts"],
      "@mirrorbase/ui/label": ["./libs/ui/label/src/index.ts"],
      "@mirrorbase/ui/popover": ["./libs/ui/popover/src/index.ts"],
      "@mirrorbase/ui/select": ["./libs/ui/select/src/index.ts"],
      "@mirrorbase/ui/separator": ["./libs/ui/separator/src/index.ts"],
      "@mirrorbase/ui/sheet": ["./libs/ui/sheet/src/index.ts"],
      "@mirrorbase/ui/sidebar": ["./libs/ui/sidebar/src/index.ts"],
      "@mirrorbase/ui/skeleton": ["./libs/ui/skeleton/src/index.ts"],
      "@mirrorbase/ui/sonner": ["./libs/ui/sonner/src/index.ts"],
      "@mirrorbase/ui/table": ["./libs/ui/table/src/index.ts"],
      "@mirrorbase/ui/textarea": ["./libs/ui/textarea/src/index.ts"],
      "@mirrorbase/ui/tooltip": ["./libs/ui/tooltip/src/index.ts"],
      "@mirrorbase/ui/utils": ["./libs/ui/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
